# Optional — used in Phase 2 when wiring live PayPal.
# VITE_PAYPAL_BUTTON_ID=

# GitHub project Pages base path (workflow sets this automatically).
# VITE_BASE=/edinburghfolkclub/

# Static news/admin demo (no Netlify Functions). Set for GitHub Pages builds.
# Password is always "admin". Edits persist in localStorage only.
# VITE_NEWS_DEMO=1

# News admin (Netlify / local). Defaults exist for local Vite dev only.
# NEWS_ADMIN_PASSWORD=change-me
# NEWS_ADMIN_SECRET=long-random-string

# Force the file-backed news store even when NETLIFY is set (local testing).
# NEWS_USE_LOCAL=1
