# Optional — used in Phase 2 when wiring live PayPal.
# VITE_PAYPAL_BUTTON_ID=

# GitHub project Pages base path (workflow sets this automatically).
# VITE_BASE=/edinburghfolkclub/

# Static news/admin demo (no Netlify Functions). Set for GitHub Pages builds.
# Password is always "admin". Edits persist in localStorage only.
# VITE_NEWS_DEMO=1

# News admin (Netlify / local). Defaults exist for local Vite dev only.
# NEWS_ADMIN_PASSWORD=change-me
# NEWS_ADMIN_SECRET=long-random-string

# Force the file-backed news and members stores even when NETLIFY is set (local testing).
# NEWS_USE_LOCAL=1

# Live Netlify Forms submissions. Set automatically on Netlify builds via netlify.toml.
# Leave unset for local Vite and the GitHub Pages demo.
# VITE_NETLIFY_FORMS=1

# Newsletter (Resend). Required to send from /admin/newsletter.
# RESEND_API_KEY=re_xxxxxxxxx
# NEWSLETTER_FROM=Edinburgh Folk Club <newsletter@your-verified-domain.com>
# Password entered in admin before sending a test or list email.
# NEWSLETTER_SEND_KEY=change-me
# Optional absolute site origin for links/images in emails (Netlify sets URL).
# SITE_URL=https://efc1973.com
